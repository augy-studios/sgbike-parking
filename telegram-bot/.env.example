# Copy this file to .env and fill it in. Never commit the result.
#
#   cp .env.example .env
#   chmod 600 .env

# ── Telegram ────────────────────────────────────────────────────────────────
# API id and hash come from https://my.telegram.org, under API development
# tools. They identify the application, not the bot.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The bot token from BotFather. See SETUP.md.
TELEGRAM_BOT_TOKEN=

# Used to build the deep link the web app sends people to. No leading @.
BOT_USERNAME=sgbikepark_bot

# ── Supabase ────────────────────────────────────────────────────────────────
# The same project the web app uses. Run main-site/migrations first.
# The service key bypasses row level security, so treat it like a password and
# never put it anywhere a browser can reach.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# ── LTA DataMall ────────────────────────────────────────────────────────────
# Request an account key at https://datamall.lta.gov.sg/content/datamall/en.html
# This is the same key the website uses for its serverless proxy.
LTA_ACCOUNT_KEY=

# ── Links shown in chat ─────────────────────────────────────────────────────
# Where the web app is deployed. This is what the Open the web app buttons use,
# and it must match the site that mints the link tokens.
WEB_APP_URL=https://sgbikeparking.uwuapps.com

# Where the donate button goes.
DONATION_URL=https://donate.stripe.com/28o2akeAr3hv0DK6oo

# ── Optional ────────────────────────────────────────────────────────────────
# Local state. The database holds the persistent buttons and the job queue, so
# keep it on disk that survives a redeploy and back it up.
# DB_PATH=./data/bot.db
# SESSION_PATH=./data/bot_session

# Search defaults for someone who has never touched /settings.
# DEFAULT_RADIUS_KM=0.5
# DEFAULT_RESULT_LIMIT=5

# How long an LTA response is reused. The dataset changes monthly, so six
# hours is already conservative.
# LTA_CACHE_TTL_SECONDS=21600
# GEOCODE_CACHE_TTL_SECONDS=604800

# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
